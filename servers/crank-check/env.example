# AO CU Verifier + Crank Check Configuration
# Copy this file to .env and fill in your values

# ===================
# Required Settings
# ===================

# Path to your Arweave wallet JSON file
WALLET_FILE=./wallet.json

# Process IDs to allow (comma-separated)
# Only these processes will be evaluated by the CU
ALLOW_PROCESSES=ijCygKzV48PHx_TUdFN7NNJgbBUatQDL_h8FfqVzXfE

# Process IDs to verify (comma-separated)
# The verifier will check if output messages for these processes are on Arweave
VERIFIER_PROCESS_IDS=ijCygKzV48PHx_TUdFN7NNJgbBUatQDL_h8FfqVzXfE

# ===================
# GraphQL / Gateway
# ===================

GRAPHQL_URL=https://arweave-search.goldsky.com/graphql
CHECKPOINT_GRAPHQL_URL=https://arweave-search.goldsky.com/graphql
GATEWAY_URL=https://arweave.net
ARWEAVE_URL=https://arweave.net

# ===================
# Memory / Compute
# ===================

# 16GB memory limit (in bytes)
PROCESS_WASM_MEMORY_MAX_LIMIT=17179869184

# ===================
# Checkpoints
# ===================

# Trusted checkpoint owners (comma-separated wallet addresses)
#PROCESS_CHECKPOINT_TRUSTED_OWNERS=WjnS-s03HWsDSdMnyTdzB1eHZB2QheUWP_FVRVYxkXk,-HFe6PleLxj1EdFMYMSetT2NIJioDsZIktn-Y0AwP54

DISABLE_PROCESS_FILE_CHECKPOINT_CREATION=false
DISABLE_PROCESS_CHECKPOINT_CREATION=false

# ===================
# Verifier Settings
# ===================

# Interval between verification cycles (ms)
VERIFIER_INTERVAL_MS=60000

# Messages to verify per cycle
VERIFIER_BATCH_SIZE=100

# Minutes before retrying unfound messages
VERIFIER_RETRY_AFTER_MINUTES=10

# Use ao-cache.sqlite for HISTORICAL evaluations (recommended)
# This syncs all past messages from the CU's cache instead of only new ones
VERIFIER_USE_CACHE=/db/ao-cache.sqlite

# Seconds to wait before starting verifiers (allow CU to initialize)
VERIFIER_STARTUP_DELAY=30

# Seconds to wait before restarting a failed/exited verifier
VERIFIER_RESTART_DELAY=60

# ===================
# Ports
# ===================

CU_PORT=6363
CRANK_CHECK_PORT=3000
