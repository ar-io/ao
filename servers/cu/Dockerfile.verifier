FROM node:22

WORKDIR /usr/app

# Install dependencies
COPY ./package.json .
COPY ./package-lock.json .
RUN npm install --omit=dev

# Copy application source
COPY ./src ./src
COPY ./scripts ./scripts

# Install required system packages
RUN apt-get update && apt-get install -y sqlite3 jq && rm -rf /var/lib/apt/lists/*

# Copy startup script
COPY ./start-with-verifier.sh /usr/app/start-with-verifier.sh
RUN chmod +x /usr/app/start-with-verifier.sh

# Create necessary directories
RUN mkdir -p /db/ /file-checkpoints/ /data/process-messages/ /data/verification/

# Set environment variables
ENV NODE_ENV=production
ENV MESSAGE_TRACKING_ENABLED=true
ENV MESSAGE_TRACKING_DB_DIR=/data/process-messages
ENV VERIFICATION_DB_DIR=/data/verification

# Expose server port
EXPOSE 6363

CMD ["/usr/app/start-with-verifier.sh"]
